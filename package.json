{
  "name": "oneios-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "bunx wrangler d1 execute oneios-tracker --local --file=migrations/0001_init.sql && bunx wrangler d1 execute oneios-tracker --local --file=migrations/0002_auth.sql",
    "db:tables:local": "wrangler d1 execute oneios-tracker --local --command=\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\"",
    "typecheck": "tsc --noEmit",
    "db:migrate:remote": "bunx wrangler d1 execute oneios-tracker --remote --file=migrations/0001_init.sql && bunx wrangler d1 execute oneios-tracker --remote --file=migrations/0002_auth.sql",
    "seed:local": "node seed/apply.mjs --local",
    "seed:remote": "node seed/apply.mjs --remote",
    "check": "node cli.mjs check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-tabs": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "latest",
    "cn": "^0.5.2",
    "lucide-react": "latest",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "shadcn": "^4.23.0",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@tailwindcss/vite": "latest",
    "@tanstack/router-plugin": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-tsconfig-paths": "latest",
    "wrangler": "latest"
  }
}