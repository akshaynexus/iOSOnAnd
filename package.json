{
  "name": "oneios-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/setup-local.mjs && vite dev",
    "dev:only": "vite dev",
    "setup": "node scripts/setup-local.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/api",
    "check": "node cli.mjs check",
    "db:migrate:local": "bunx wrangler d1 migrations apply oneios-tracker --local",
    "db:migrate:remote": "bunx wrangler d1 migrations apply oneios-tracker --remote",
    "db:tables:local": "wrangler d1 execute oneios-tracker --local --command=\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\"",
    "seed:local": "node seed/apply.mjs --local",
    "seed:remote": "node seed/apply.mjs --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "lucide-react": "1.77.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/mdx": "2.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "4.166.0"
  }
}
