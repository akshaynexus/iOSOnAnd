# iOSOnAnd local dev vars. `bun run dev` (or `bun run setup`) copies this file
# to `.dev.vars` when that file is missing and fills ADMIN_EMAIL and a random
# ADMIN_PASSWORD. `.dev.vars` is git-ignored. Keep the values in THIS file
# empty. Production secrets go in `wrangler secret put NAME`.

# Bootstrap admin. Logging in with exactly these values creates the account
# if needed and makes it an admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: server-side GitHub token for API enrichment (fork/reddit lookups).
GITHUB_TOKEN=

# Password pepper: an HMAC key mixed into every password hash, kept out of the
# database. `bun run setup` fills a random one into .dev.vars. Production:
# `wrangler secret put PASSWORD_PEPPER` once (e.g. `openssl rand -base64 32`)
# and never change or lose it: every peppered password stops working.
PASSWORD_PEPPER=

# Password-reset mail (Cloudflare Email Service, binding EMAIL). Local dev
# prints the mail in the dev server console instead of sending it.
MAIL_FROM=
# The site URL used in mailed links, e.g. https://tracker.example.com
# (empty: the URL the request came to).
PUBLIC_URL=

# off turns every rate limit off (local test runs only; never in production).
RATE_LIMITS=
